[all:vars]
ansible_user={{ node_user }}
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file={{ ssh_private_key }}
ansible_ssh_extra_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[masters]
{% for ec2 in running.instances if ec2.tags.Name == 'master' %}
{{ ec2.tags.Name }} ansible_host={{ ec2.public_ip_address }} private_ip={{ ec2.private_ip_address }}
{% endfor %}

[workers]
{% for ec2 in running.instances | sort(attribute='tags.Name') if ec2.tags.Name != 'master' %}
{{ ec2.tags.Name }} ansible_host={{ ec2.public_ip_address }} private_ip={{ ec2.private_ip_address }}
{% endfor %}

[k8s:children]
masters
workers
