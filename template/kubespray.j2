[all]
master ansible_connection=local ansible_host={{ hostvars['master'].private_ip }} ip={{ hostvars['master'].private_ip }}
{% for h in ['node1', 'node2', 'node3'] %}
{{ h }} ansible_host={{ hostvars[h].private_ip }} ip={{ hostvars[h].private_ip }}
{% endfor %}

[kube_control_plane]
master

[etcd]
master

[kube_node]
node1
node2
node3

[k8s_cluster:children]
kube_control_plane
kube_node

[all:vars]
ansible_user={{ node_user }}
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=/home/{{ node_user }}/.ssh/id_ed25519
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
